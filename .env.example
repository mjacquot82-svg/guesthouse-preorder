# Backend database
DATABASE_URL=postgresql+psycopg://postgres.project-ref:change-me@aws-region.pooler.supabase.com:5432/postgres?sslmode=require

# Frontend build-time configuration
VITE_API_BASE_URL=https://api.ladels.jdsstudio.ca

# Backend public URLs (no trailing slash)
FRONTEND_URL=https://ladels.jdsstudio.ca
PUBLIC_APP_URL=https://api.ladels.jdsstudio.ca

# Clover app credentials from the Developer Dashboard
CLOVER_ENVIRONMENT=sandbox
CLOVER_APP_ID=
CLOVER_APP_SECRET=
# Pin the one merchant this storefront is allowed to charge.
CLOVER_MERCHANT_ID=
CLOVER_STATE_SECRET=
CLOVER_WEBHOOK_SECRET=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Fernet key used to encrypt OAuth tokens at rest
CLOVER_TOKEN_ENCRYPTION_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Optional Hosted Checkout page UUID
CLOVER_PAGE_CONFIG_UUID=

# Optional single-merchant Hosted Checkout credential. When set, checkout uses
# it instead of the OAuth token for the pinned CLOVER_MERCHANT_ID.
CLOVER_ECOMMERCE_PRIVATE_TOKEN=
PUSH_RELEASE_ENABLED=false
PUSH_ENROLLMENT_ENABLED=false
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:operations@example.com
WEB_PUSH_SUBSCRIPTION_ENCRYPTION_KEY=
PUSH_BATCH_SIZE=50
PUSH_REQUEST_TIMEOUT_SECONDS=10
PUSH_DEFAULT_TTL_SECONDS=14400
PUSH_MAX_ATTEMPTS=4
PUSH_RETENTION_DAYS=90
