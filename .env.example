# Backend database
DATABASE_URL=postgresql+psycopg://app_user:change-me@db.example.com:5432/guesthouse

# Frontend build-time configuration
VITE_API_BASE_URL=https://api.example.com

# Backend public URLs (no trailing slash)
FRONTEND_URL=https://storefront.example.com
PUBLIC_APP_URL=https://api.example.com

# Clover app credentials from the Developer Dashboard
CLOVER_ENVIRONMENT=sandbox
CLOVER_APP_ID=
CLOVER_APP_SECRET=
# Pin the one merchant this storefront is allowed to charge.
CLOVER_MERCHANT_ID=
CLOVER_STATE_SECRET=
CLOVER_WEBHOOK_SECRET=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Fernet key used to encrypt OAuth tokens at rest
CLOVER_TOKEN_ENCRYPTION_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Optional Hosted Checkout page UUID
CLOVER_PAGE_CONFIG_UUID=

# Optional single-merchant Hosted Checkout credential. When set, checkout uses
# it instead of the OAuth token for the pinned CLOVER_MERCHANT_ID.
CLOVER_ECOMMERCE_PRIVATE_TOKEN=
